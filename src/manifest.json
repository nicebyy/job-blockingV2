{
  "manifest_version": 3,
  "name": "Job Blocking V2 - 채용 사이트 공고 필터링",
  "short_name": "Job Blocking V2",
  "version": "0.1.0",
  "description": "원티드, 사람인, 잡코리아, 리멤버 등 채용 사이트의 원치 않는 회사 및 광고 공고를 숨기거나 블러 처리합니다.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage",
    "activeTab",
    "tabs"
  ],
  "host_permissions": [
    "https://*.wanted.co.kr/*",
    "https://*.saramin.co.kr/*",
    "https://*.jobkorea.co.kr/*",
    "https://*.rememberapp.co.kr/*",
    "https://*.jobplanet.co.kr/*",
    "https://*.teamblind.com/*"
  ],
  "action": {
    "default_popup": "src/popup/index.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "src/background/index.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.wanted.co.kr/*",
        "https://*.saramin.co.kr/*",
        "https://*.jobkorea.co.kr/*",
        "https://*.rememberapp.co.kr/*"
      ],
      "js": ["src/content/index.ts"],
      "css": ["src/content/style.css"],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "src/options/index.html",
    "open_in_tab": true
  }
}
