{
  "name": "job-blocking-v2",
  "version": "0.2.3",
  "description": "채용 사이트 공고 필터링 크롬 확장 프로그램",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "pretest:e2e": "npm run build",
    "test:e2e": "playwright test",
    "verify:version": "node scripts/check-version-sync.mjs",
    "verify:dist": "node scripts/check-dist-integrity.mjs",
    "verify:all": "npm run typecheck && npm test && npm run build && npm run verify:version && npm run verify:dist",
    "release": "npm run build && npm run verify:version && npm run verify:dist && node scripts/package-release.mjs",
    "fetch:sample": "node scripts/fetch-sample.mjs",
    "eval:ts": "node scripts/eval-ts.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^3.0.0",
    "@playwright/test": "^1.49.0",
    "@types/chrome": "^0.0.280",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^2.1.8",
    "happy-dom": "^15.11.7",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2",
    "vite": "^6.0.0",
    "vitest": "^2.1.8"
  }
}
